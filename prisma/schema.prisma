generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  uuid      String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique @db.VarChar(100)
  desc      String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Feature {
  uuid             String   @id @default(uuid(7)) @db.Uuid
  key              String   @unique @db.VarChar(100)
  name             String   @db.VarChar(100)
  desc             String?  @db.VarChar(255)
  availableActions String[] @map("available_actions")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]

  @@map("features")
}

model RolePermission {
  uuid        String   @id @default(uuid(7)) @db.Uuid
  roleUuid    String   @map("role_uuid") @db.Uuid
  featureUuid String   @map("feature_uuid") @db.Uuid
  isRead      Boolean  @default(false) @map("is_read")
  isAdd       Boolean  @default(false) @map("is_add")
  isEdit      Boolean  @default(false) @map("is_edit")
  isDelete    Boolean  @default(false) @map("is_delete")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  role    Role    @relation(fields: [roleUuid], references: [uuid], onDelete: Cascade)
  feature Feature @relation(fields: [featureUuid], references: [uuid], onDelete: Cascade)

  @@unique([roleUuid, featureUuid])
  @@index([featureUuid])
  @@map("role_permissions")
}

enum Gender {
  MALE
  FEMALE
}

model User {
  uuid             String   @id @default(uuid(7)) @db.Uuid
  name             String   @db.VarChar(100)
  email            String   @unique @db.VarChar(191)
  password         String   @db.VarChar(255)
  roleUuid         String   @map("role_uuid") @db.Uuid
  photo            String?  @db.VarChar(255)
  phone            String?  @db.VarChar(30)
  gender           Gender?
  isActive         Boolean  @default(true) @map("is_active")
  sessionVersion   Int      @default(0) @map("session_version")
  mfaEnabled       Boolean  @default(false) @map("mfa_enabled")
  mfaSecret        String?  @map("mfa_secret") @db.VarChar(255)
  mfaRecoveryCodes String[] @default([]) @map("mfa_recovery_codes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  role     Role          @relation(fields: [roleUuid], references: [uuid], onDelete: Restrict)
  sessions UserSession[]

  @@index([roleUuid])
  @@index([isActive])
  @@map("users")
}

model UserSession {
  uuid       String   @id @default(uuid(7)) @db.Uuid
  userUuid   String   @map("user_uuid") @db.Uuid
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")

  user User @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)

  @@index([userUuid, expiresAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model RateLimitBucket {
  key       String   @id @db.VarChar(191)
  count     Int      @default(1)
  resetAt   DateTime @map("reset_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

model MfaAttempt {
  uuid      String   @id @default(uuid(7)) @db.Uuid
  userUuid  String?  @map("user_uuid") @db.Uuid
  ip        String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userUuid, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("mfa_attempts")
}

model LoginAttempt {
  uuid      String   @id @default(uuid(7)) @db.Uuid
  email     String   @db.VarChar(191)
  ip        String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, ip, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

model AuditLog {
  uuid       String   @id @default(uuid(7)) @db.Uuid
  actorUuid  String?  @map("actor_uuid") @db.Uuid
  actorName  String?  @map("actor_name") @db.VarChar(100)
  actorEmail String?  @map("actor_email") @db.VarChar(191)
  action     String   @db.VarChar(60)
  targetType String?  @map("target_type") @db.VarChar(50)
  targetUuid String?  @map("target_uuid") @db.VarChar(64)
  detail     String?  @db.VarChar(1000)
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorUuid, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Item {
  uuid        String   @id @default(uuid(7)) @db.Uuid
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("items")
}