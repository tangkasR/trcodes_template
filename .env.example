# ==========================================
# KONFIGURASI DOCKER & POSTGRESQL (Untuk VPS)
# ==========================================
POSTGRES_DB="db_name"
POSTGRES_USER="db_user"
POSTGRES_PASSWORD="ganti-dengan-password-db-sangat-kuat-123!"

# Port yang diexpose ke host (default 3004 agar aman dari PM2 port 3000-3003)
APP_PORT=3000

# ==========================================
# KONFIGURASI APLIKASI UTAMA
# ==========================================
# Jika deploy menggunakan Docker Compose, DATABASE_URL otomatis disusun dari variabel POSTGRES di atas.
# Jika menjalankan lokal tanpa Docker:
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/db_name"

# Secret Session JWT (Wajib minimal 32 karakter acak)
# windows: $secret = -join (1..32 | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) }); $secret
# vps: openssl rand -hex 32
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Akun Awal Super Admin (Digunakan saat menjalankan database seed)
SEED_ADMIN_NAME="Super Administrator"
SEED_ADMIN_EMAIL="admin@yourdomain.com"
# Password unik minimal 12 karakter sebelum menjalankan seed
SEED_ADMIN_PASSWORD="PasswordSangatKuat123!"

# Di production dengan Nginx reverse proxy, wajib set "true"
TRUST_PROXY="true"

# Seed bersifat destruktif (menghapus semua data). Di production, set ini ke
# "true" hanya saat pertama kali inisialisasi master data.
ALLOW_DESTRUCTIVE_SEED="false"

# Opsional. Kunci enkripsi secret TOTP; jika kosong, diturunkan dari SESSION_SECRET.
# Minimal 32 karakter. Jangan ganti setelah MFA dipakai.
# MFA_ENCRYPTION_KEY=""

# Opsional. Wajibkan Super Admin mengaktifkan MFA sebelum mengakses modul lain.
ENFORCE_SUPER_ADMIN_MFA="false"

# Opsional: path ke Chrome/Edge untuk `npm run smoke` lokal
# CHROME_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
